# JetPack 7 / Jetson Thor TensorRT Edge-LLM benchmark image.
ARG BASE_IMAGE_ARM64=nvcr.io/nvidia/tensorrt:25.11-py3@sha256:6a507190873a87ee42205d5b2392491078aca971b1b25cda5f1053d72366bb89
ARG BASE_IMAGE_AMD64=nvcr.io/nvidia/tensorrt:25.11-py3
ARG BASE_STAGE_NAME=base_arm64
# Builds the Spot C++ SDK and bosdyn_msgs; must be the same Ubuntu (noble) and
# ROS distro as the final image, whose apt libprotobuf/libgrpc they link.
ARG SPOT_BUILD_IMAGE=ros:jazzy-ros-base@sha256:ec00a06df4f573a86e4336c4585940f7f614646ef22675ace1b3e14ee0a82cb3
# One Spot SDK version for the C++ SDK, bosdyn_msgs and the bosdyn-* wheels.
ARG SPOT_SDK_VERSION=5.0.1

FROM ${BASE_IMAGE_ARM64} AS base_arm64
FROM ${BASE_IMAGE_AMD64} AS base_amd64

# --- Spot C++ SDK + bosdyn_msgs ---------------------------------------------
# Upstream ships both only as jammy/Humble binaries (the SDK deb links
# libprotobuf23, which noble lacks), so they are built here against noble's own
# protobuf 3.21 / gRPC 1.51 and copied into the final image. A separate stage
# keeps bosdyn_msgs' build-time protobuf<=4.22 pin away from the Edge-LLM stack.
# The SDK misses one <cstdint> include that gcc 13 no longer gives it for free.
FROM ${SPOT_BUILD_IMAGE} AS spot_build
ARG SPOT_SDK_VERSION
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        cmake \
        build-essential \
        pkg-config \
        python3-pip \
        libprotobuf-dev \
        protobuf-compiler \
        libgrpc++-dev \
        protobuf-compiler-grpc \
        libcli11-dev \
        libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --branch "v${SPOT_SDK_VERSION}" --depth 1 https://github.com/rai-opensource/spot-cpp-sdk.git /tmp/spot-cpp-sdk \
 && cmake -S /tmp/spot-cpp-sdk/cpp -B /tmp/spot-cpp-sdk/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/spot-cpp-sdk \
        -DCMAKE_CXX_FLAGS="-include cstdint" \
 && cmake --build /tmp/spot-cpp-sdk/build -j"$(nproc)" \
 && cmake --install /tmp/spot-cpp-sdk/build \
 && rm -rf /tmp/spot-cpp-sdk
# bosdyn_msgs' bosdyn_cmake_module looks for the SDK at /opt/spot-cpp-sdk. The
# proto2ros it vendors as a submodule predates Python 3.12 (importlib.resources
# misuse); rosdep installs Jazzy's packaged ros-jazzy-proto2ros instead.
WORKDIR /opt/bosdyn_ws
RUN git clone --branch "${SPOT_SDK_VERSION}" --depth 1 \
        https://github.com/rai-opensource/bosdyn_msgs.git src/bosdyn_msgs \
 && touch src/bosdyn_msgs/proto2ros/COLCON_IGNORE \
 && apt-get update \
 && rosdep update --rosdistro jazzy \
 && PIP_CONSTRAINT=src/bosdyn_msgs/pip-constraint.txt \
    rosdep install -i -y -r --from-paths src --rosdistro jazzy \
        --skip-keys "$(cat src/bosdyn_msgs/rosdep-skip.txt)" \
 && rm -rf /var/lib/apt/lists/* \
 && . /opt/ros/jazzy/setup.sh \
 && colcon build --merge-install --install-base /opt/bosdyn_ws/install \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
 && rm -rf build log src

FROM ${BASE_STAGE_NAME} AS final

ARG username=ros
ARG EDGELLM_VERSION=v0.10.1
ARG EDGELLM_ROOT=/opt/TensorRT-Edge-LLM
ARG XTOP_VERSION=v0.1.1
# CUDA toolkit version of the base image; must match the JetPack 7.0/7.1 host.
ARG CUDA_CTK_VERSION=13.0

LABEL com.foresight.platform="jetson-thor" \
      com.foresight.jetpack="7" \
      com.foresight.cuda-arch="sm_110" \
      com.foresight.edgellm-version="${EDGELLM_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        build-essential \
        git \
        curl \
        ca-certificates \
        python3-venv \
        libopenmpi-dev \
    && rm -rf /var/lib/apt/lists/*

# xtop: btop-like CPU/GPU/memory/IO monitor for watching benchmarks. Upstream
# publishes amd64-only release binaries, so build from source with a throwaway
# rustup toolchain that is removed once the binary is installed.
# GPU metrics load NVML dynamically at runtime, so nothing links against it here.
RUN export RUSTUP_HOME=/tmp/rustup CARGO_HOME=/tmp/cargo \
 && curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --no-modify-path \
 && git clone --branch "${XTOP_VERSION}" --depth 1 https://github.com/joydeep-b/xtop.git /tmp/xtop \
 && make -C /tmp/xtop install PREFIX=/usr/local CARGO=/tmp/cargo/bin/cargo \
 && rm -rf /tmp/rustup /tmp/cargo /tmp/xtop \
 && xtop --probe > /dev/null

# C++ runtime: ONNX -> engine builders and the llm_inference benchmark binary.
# The JetPack 7.0/7.1 Thor configuration from the Edge-LLM installation guide.
# The base image bundles CMake 3.24 in /usr/local/bin, which rejects the sm_110a
# architecture the Thor target selects; use the apt CMake (>= 3.27) instead.
RUN git clone --branch "${EDGELLM_VERSION}" --depth 1 --recurse-submodules --shallow-submodules \
        https://github.com/NVIDIA/TensorRT-Edge-LLM.git "${EDGELLM_ROOT}" \
 && cd "${EDGELLM_ROOT}" \
 && mkdir -p build && cd build \
 && /usr/bin/cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DTRT_PACKAGE_DIR=/usr \
        -DCMAKE_TOOLCHAIN_FILE=cmake/aarch64_linux_toolchain.cmake \
        -DEMBEDDED_TARGET=jetson-thor \
        -DCUDA_CTK_VERSION="${CUDA_CTK_VERSION}" \
        -DENABLE_CUTE_DSL=ALL \
 && make -j"$(nproc)" \
 && test -x examples/llm/llm_build \
 && test -x examples/llm/llm_inference \
 && test -x examples/multimodal/visual_build

# Python stack, installed into the system interpreter: no venv. Edge-LLM's
# export tooling and memo's model inference share one torch, so it is the CUDA
# 13.0 build (sm_110) rather than the CPU wheels export alone would need. torch
# and torchvision come first from the cu130 index, at the versions Edge-LLM pins,
# so its own install finds them satisfied. The "tools" extra is required rather
# than "export": the visual-encoder export path imports nvidia-modelopt even for
# unquantized FP16 checkpoints. nvidia-modelopt needs setuptools>=80, above
# colcon-core's declared cap; colcon build (incl. --symlink-install) still works,
# so `pip check` flagging it is expected.
#
# Only the heavy, version-coupled packages are baked. memo itself and its light
# deps are installed from the bind-mounted checkout when the container starts
# (scripts/setup_memo.sh), constrained to what is frozen here.
#
# This runs before ROS on purpose: pip owns /usr/local/lib/python3.12, apt then
# owns /usr/lib/python3, and pip never has to uninstall an apt package.
ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_ROOT_USER_ACTION=ignore
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu130 \
        torch==2.13.0 torchvision==0.28.0 \
 && pip install --no-cache-dir \
        -e "${EDGELLM_ROOT}[tools]" \
        pillow \
 && tensorrt-edgellm-export --help > /dev/null \
 && python3 -c "import torch, transformers; assert torch.version.cuda.startswith('13.'), torch.version.cuda; from transformers import Qwen3_5ForConditionalGeneration" \
 && mkdir -p /etc/memo && pip list --format=freeze --exclude-editable > /etc/memo/constraints.txt

# Qwen3.5's fast path: flash-linear-attention (Triton kernels for the Gated
# DeltaNet layers) and causal-conv1d (CUDA, compiled here for sm_110; there is no
# aarch64 CUDA 13 wheel). Without them transformers falls back to a reference
# implementation that launches ~5x more kernels; on Thor that cut MemoVLA's VLM
# prefix from ~145 ms to ~55 ms. --no-build-isolation so causal-conv1d builds
# against the torch above; constrained so neither can move the stack.
RUN pip install --no-cache-dir -c /etc/memo/constraints.txt flash-linear-attention \
 && CAUSAL_CONV1D_FORCE_BUILD=TRUE MAX_JOBS=8 \
    pip install --no-cache-dir --no-build-isolation -c /etc/memo/constraints.txt causal-conv1d \
 && python3 -c "import fla, causal_conv1d" \
 && pip list --format=freeze --exclude-editable > /etc/memo/constraints.txt

# Robot-side Python: the Spot SDK client (spot_wrapper / spot_driver) and audio
# capture, constrained like the layers above so none of it can move the Edge-LLM
# stack; bosdyn runs on its protobuf 7 / numpy 2. opencv-python-headless (also a
# memo dependency) shadows the numpy-1 python3-opencv that cv_bridge pulls from
# apt; it stays on OpenCV 4 because 5 renumbered the CV_* type codes, which
# breaks cv_bridge against ROS's OpenCV 4.6. aiortc is spot_wrapper's Spot CAM WebRTC client, which spot_driver imports
# even with the CAM off; it caps av<18 while memo needs av>=18.1, and it imports
# and runs on the newer av, so it goes in without its own dependency pins.
# open3d is left out: only the arm's hand-camera depth publisher uses it.
# Declared here, not with the other ARGs, so it does not invalidate the
# Edge-LLM layers above.
ARG SPOT_SDK_VERSION
RUN pip install --no-cache-dir -c /etc/memo/constraints.txt \
        bosdyn-api==${SPOT_SDK_VERSION} \
        bosdyn-core==${SPOT_SDK_VERSION} \
        bosdyn-client==${SPOT_SDK_VERSION} \
        bosdyn-mission==${SPOT_SDK_VERSION} \
        bosdyn-choreography-client==${SPOT_SDK_VERSION} \
        bosdyn-choreography-protos==${SPOT_SDK_VERSION} \
        inflection \
        "av>=18.1" aioice "cryptography>=44" google-crc32c pyee pylibsrtp pyopenssl \
        "opencv-python-headless>=4.10,<5" \
        sounddevice \
 && pip install --no-cache-dir --no-deps aiortc==1.15.0 \
 && python3 -c "import bosdyn.client, bosdyn.api.spot.robot_command_pb2, aiortc, av, cv2; import torch; assert torch.version.cuda.startswith('13.')" \
 && pip list --format=freeze --exclude-editable > /etc/memo/constraints.txt

# --- ROS 2 ------------------------------------------------------------------
# Everything below sits after the Edge-LLM build so that editing it never
# invalidates those (slow) layers.
#
# Humble has no Ubuntu 24.04 binaries, and the CUDA 13 base Thor needs is 24.04;
# Jazzy is the noble LTS and runs on the base image's own Python 3.12.
ARG ROS_DISTRO=jazzy
# Must match the basename of the workspace that config/mounts binds into
# /home/${username}; ./container passes it.
ARG WS_NAME=memo_ws

LABEL com.foresight.ros-distro="${ROS_DISTRO}"

# ROS 2 requires a UTF-8 locale.
RUN apt-get update && apt-get install -y --no-install-recommends \
        locales \
        lsb-release \
        gnupg2 \
    && locale-gen en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# ROS 2 from the official apt repo. Fetching ros.key from rosdistro master picks
# up the current (rotated) signing key at build time. Headless: ros-base only.
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list \
 && apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-rosbag2-storage-mcap \
        ros-${ROS_DISTRO}-foxglove-bridge \
        ros-dev-tools \
        python3-colcon-common-extensions \
        python3-rosdep \
 && rm -rf /var/lib/apt/lists/* \
 && rosdep init && rosdep update --rosdistro "${ROS_DISTRO}"

# --- Sensor drivers -----------------------------------------------------------
# The drivers themselves live in src/ (scripts/checkout.sh) and build with
# colcon: spot_ros2, k4a_ros (+ amrl_shared_lib, config_reader), livox_ros_driver2,
# spot_velodyne, joystick. The image carries their dependencies, the vendor SDKs
# and the VectorNav overlay. Any pip install rosdep makes below is held to the
# frozen stack by PIP_CONSTRAINT; apt's python3-* (numpy 1.26, opencv 4.6) land in
# /usr/lib/python3 and stay shadowed by the pip-owned versions.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-image-transport-plugins \
        ros-${ROS_DISTRO}-point-cloud-transport \
        ros-${ROS_DISTRO}-pcl-conversions \
        ros-${ROS_DISTRO}-velodyne \
        ros-${ROS_DISTRO}-joy \
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-imu-sensor-broadcaster \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-tf2-sensor-msgs \
        ros-${ROS_DISTRO}-diagnostic-updater \
        ros-${ROS_DISTRO}-foxglove-msgs \
        # k4a_ros, amrl_shared_lib, config_reader, joystick
        libgoogle-glog-dev \
        libgflags-dev \
        liblua5.2-dev \
        libgoogle-perftools-dev \
        cimg-dev \
        libeigen3-dev \
        libopencv-dev \
        # livox_ros_driver2
        libpcl-dev \
        libapr1-dev \
        # MPU6050 (i2c), serial sensors, Azure Kinect mic array, camera streaming
        libi2c-dev \
        python3-serial \
        libserialport0 \
        libportaudio2 \
        portaudio19-dev \
        alsa-utils \
        gstreamer1.0-tools \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-libav \
        # Spot C++ SDK consumers (spot_driver)
        libprotobuf-dev \
        protobuf-compiler \
        libgrpc++-dev \
        protobuf-compiler-grpc \
        libcli11-dev \
    && rm -rf /var/lib/apt/lists/*

# cv_bridge, rebuilt from the same release as the apt package: apt's Python
# extension is compiled against numpy 1.26 and fails to import under the image's
# numpy 2 (spot_driver uses it). The overlay is sourced ahead of the others.
ARG CV_BRIDGE_VERSION=4.1.0
RUN git clone --branch "${CV_BRIDGE_VERSION}" --depth 1 https://github.com/ros-perception/vision_opencv.git /tmp/vision_opencv \
 && mkdir -p /opt/cv_bridge_ws/src \
 && mv /tmp/vision_opencv/cv_bridge /opt/cv_bridge_ws/src/ \
 && rm -rf /tmp/vision_opencv \
 && cd /opt/cv_bridge_ws \
 && . /opt/ros/${ROS_DISTRO}/setup.sh \
 && colcon build --merge-install --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
 && rm -rf build log src \
 && . install/local_setup.sh \
 && python3 -c "import numpy as np; from cv_bridge import CvBridge; b = CvBridge(); b.imgmsg_to_cv2(b.cv2_to_imgmsg(np.zeros((4, 6, 3), np.uint8), 'bgr8'), 'rgb8')"

# Azure Kinect SDK (libk4a, with the depth engine) from Microsoft's bionic
# multiarch repo, the only arm64 build; its dependencies resolve on noble. The
# debconf answers accept the depth-engine EULA non-interactively.
ARG K4A_VERSION=1.4.2
RUN curl -sSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
 && echo "deb [arch=arm64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/ubuntu/18.04/multiarch/prod bionic main" \
        > /etc/apt/sources.list.d/microsoft-prod.list \
 && echo 'libk4a1.4 libk4a1.4/accepted-eula-hash string 0f5d5c5de396e4fee4c0753a21fee0c1ed726cf0316204edda484f08cb266d76' | debconf-set-selections \
 && echo 'libk4a1.4 libk4a1.4/accept-eula boolean true' | debconf-set-selections \
 && apt-get update && apt-get install -y --no-install-recommends \
        libk4a1.4=${K4A_VERSION} \
        libk4a1.4-dev=${K4A_VERSION} \
 && rm -rf /var/lib/apt/lists/* \
 && test -f /usr/lib/aarch64-linux-gnu/libk4a1.4/libdepthengine.so.2.0

# Livox-SDK2 into /usr/local, where livox_ros_driver2 looks for it.
ARG LIVOX_SDK2_VERSION=v1.3.1
RUN git clone --branch "${LIVOX_SDK2_VERSION}" --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git /tmp/Livox-SDK2 \
 && /usr/bin/cmake -S /tmp/Livox-SDK2 -B /tmp/Livox-SDK2/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS="-include cstdint" \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
 && /usr/bin/cmake --build /tmp/Livox-SDK2/build -j"$(nproc)" \
 && /usr/bin/cmake --install /tmp/Livox-SDK2/build \
 && rm -rf /tmp/Livox-SDK2 \
 && ldconfig \
 && test -f /usr/local/lib/liblivox_lidar_sdk_shared.so

# VectorNav driver, as an overlay in /opt/vn_ws (as on the Orin image).
ARG VECTORNAV_BRANCH=ros2_fast
RUN mkdir -p /opt/vn_ws/src \
 && git clone --branch "${VECTORNAV_BRANCH}" --depth 1 https://github.com/ut-amrl/vectornav.git /opt/vn_ws/src/vectornav \
 && cd /opt/vn_ws \
 && . /opt/ros/${ROS_DISTRO}/setup.sh \
 && apt-get update \
 && PIP_CONSTRAINT=/etc/memo/constraints.txt rosdep install --from-paths src --ignore-src -y -r --rosdistro "${ROS_DISTRO}" \
 && rm -rf /var/lib/apt/lists/* \
 && colcon build --merge-install --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
 && rm -rf build log

# Spot: the SDK and bosdyn_msgs from the spot_build stage, then spot_ros2's
# remaining dependencies, resolved from a throwaway clone at a commit with the
# Jazzy fixes (#816). Skipped: the bosdyn packages and spot_wrapper (already
# here, the Python ones from the pip layer) and the GUI ones, which only spot_rviz_plugins / joint_state_publisher_gui use.
COPY --from=spot_build /opt/spot-cpp-sdk /opt/spot-cpp-sdk
COPY --from=spot_build /opt/bosdyn_ws/install /opt/bosdyn_ws/install
ARG SPOT_ROS2_COMMIT=fc0eb245d47e146cf2a4c4fa47c9739f89bc79bd
RUN git init -q /tmp/spot_ros2 \
 && cd /tmp/spot_ros2 \
 && git fetch -q --depth 1 https://github.com/rai-opensource/spot_ros2.git "${SPOT_ROS2_COMMIT}" \
 && git checkout -q FETCH_HEAD \
 && git submodule update -q --init --depth 1 \
 && apt-get update \
 && PIP_CONSTRAINT=/etc/memo/constraints.txt rosdep install -i -y -r \
        --from-paths /tmp/spot_ros2 /opt/bosdyn_ws/install/share --rosdistro "${ROS_DISTRO}" \
        --skip-keys "bosdyn bosdyn-spot-cpp bosdyn_msgs bosdyn_api_msgs bosdyn_cmake_module spot_wrapper bosdyn-choreography-protos rviz2 joint_state_publisher_gui python3-tk" \
 && cd / && rm -rf /var/lib/apt/lists/* /tmp/spot_ros2 \
 && . /opt/ros/${ROS_DISTRO}/setup.sh \
 && . /opt/bosdyn_ws/install/local_setup.sh \
 && python3 -c "import bosdyn_api_msgs.msg, bosdyn_api_msgs.math_helpers, bosdyn_spot_api_msgs.msg, cv2, numpy; assert numpy.__version__.startswith('2.')"

RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# --- User: the host's uid/gid, so files written into the bind mounts keep the host owner -----------------------
# As docker/Dockerfile.orin: ./container passes the calling user's uid, gid and name. The base image already has a
# uid-1000 user (`ubuntu`), which is renamed rather than duplicated. Here last among the slow layers, so a
# different user only rebuilds from here.
ARG uid=1000
ARG gid=1000
# "name:gid" pairs of the host's device groups (./container fills them in): the user joins groups with the
# *host's* gids, which is what device-node permissions check (/dev/nvmap is root:video, renderD* root:render).
ARG HOST_GROUPS="video:44"
RUN set -e; \
    # Primary group: gid ${gid}, named after the user.
    if getent group ${gid} >/dev/null; then \
        current=$(getent group ${gid} | cut -d: -f1); \
        if [ "$current" != "${username}" ] && ! getent group ${username} >/dev/null; then groupmod -n ${username} "$current"; fi; \
    else \
        groupadd -g ${gid} ${username}; \
    fi; \
    # User: rename an existing uid-${uid} account (and move its home), else create one.
    if getent passwd ${uid} >/dev/null; then \
        current=$(getent passwd ${uid} | cut -d: -f1); \
        if [ "$current" != "${username}" ]; then usermod -l ${username} -d /home/${username} -m "$current"; fi; \
        usermod -g ${gid} -s /bin/bash ${username}; \
    else \
        useradd -u ${uid} -g ${gid} -m -s /bin/bash ${username}; \
    fi; \
    # Device groups at the host's gids: retarget a same-named group if that gid is free, else join whichever
    # group already holds the gid.
    for pair in ${HOST_GROUPS}; do \
        name=${pair%%:*}; g=${pair##*:}; \
        if ! getent group "$g" >/dev/null; then \
            if getent group "$name" >/dev/null; then groupmod -g "$g" "$name"; else groupadd -g "$g" "$name"; fi; \
        fi; \
        usermod -aG "$(getent group "$g" | cut -d: -f1)" ${username}; \
    done; \
    usermod -aG sudo,video ${username}; \
    echo "${username} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/${username}; \
    chmod 0440 /etc/sudoers.d/${username}; \
    visudo -c >/dev/null; \
    # Home: mount points created here, owned by the user. Docker would otherwise create missing parents of the
    # config/mounts binds (~/.cache/huggingface, ~/.ssh/...) as root, leaving ~/.cache unwritable.
    mkdir -p /home/${username}/.cache /home/${username}/.ssh /home/${username}/${WS_NAME}; \
    printf '%s\n' 'set -g mouse on' 'set -g history-limit 10000' > /home/${username}/.tmux.conf; \
    chown -R ${uid}:${gid} /home/${username}

ENV CUDA_MODULE_LOADING=LAZY \
    EDGELLM_ROOT=${EDGELLM_ROOT} \
    PATH=${EDGELLM_ROOT}/build/examples/llm:${EDGELLM_ROOT}/build/examples/multimodal:${PATH} \
    FORESIGHT_CONTAINER_BASE=nvcr.io/nvidia/tensorrt:25.11-py3 \
    HOME=/home/${username} \
    HF_HOME=/home/${username}/.cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/home/${username}/.cache/huggingface \
    ROS_DISTRO=${ROS_DISTRO} \
    ROS_WORKSPACE=/home/${username}/${WS_NAME}

# ROS environment for login shells. COLCON_DEFAULTS_FILE restricts discovery to
# the packages listed there (see colcon_defaults.yaml); colcon builds with the
# system python3, the same interpreter that holds torch and Edge-LLM. The
# cv_bridge, bosdyn_msgs and VectorNav overlays sit between ROS and the
# workspace; the bosdyn one also puts /opt/spot-cpp-sdk/lib on LD_LIBRARY_PATH.
RUN printf '%s\n' \
    "source /opt/ros/${ROS_DISTRO}/setup.bash" \
    'source /opt/cv_bridge_ws/install/local_setup.bash' \
    'source /opt/bosdyn_ws/install/local_setup.bash' \
    'source /opt/vn_ws/install/local_setup.bash' \
    '[ -f "$ROS_WORKSPACE/install/setup.bash" ] && source "$ROS_WORKSPACE/install/setup.bash"' \
    'export RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-rmw_cyclonedds_cpp}' \
    'export ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}' \
    'export COLCON_DEFAULTS_FILE=${COLCON_DEFAULTS_FILE:-$ROS_WORKSPACE/colcon_defaults.yaml}' \
    > /etc/profile.d/ros2.sh && chmod a+r /etc/profile.d/ros2.sh

# memo is never baked: the first login shell of each container installs it from
# the bind-mounted checkout (editable, with its light runtime deps). The script
# lives in the workspace so it can change without a rebuild.
RUN printf '%s\n' \
    '[ -x "$ROS_WORKSPACE/scripts/setup_memo.sh" ] && "$ROS_WORKSPACE/scripts/setup_memo.sh" --if-needed' \
    > /etc/profile.d/zz-memo.sh && chmod a+r /etc/profile.d/zz-memo.sh

# By name, not uid:gid: Docker loads supplementary groups (video, render, ...) only for a named USER.
USER ${username}
WORKDIR /home/${username}/${WS_NAME}

ENTRYPOINT []
CMD ["/bin/bash", "-l"]
